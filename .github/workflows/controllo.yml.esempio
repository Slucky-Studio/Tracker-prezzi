# Controllo dei prezzi a PC spento — facoltativo.
# Per attivarlo: rinomina questo file in controllo.yml, e ricorda che il
# workflow scrive dati/prodotti.json nel repository, quindi quel file va
# tolto da .gitignore e committato. Se il repo è pubblico,
# la tua lista della spesa diventa pubblica: usa un repository privato.
name: Controllo prezzi

on:
  schedule:
    - cron: '0 6 * * *'   # 06:00 UTC = 08:00 in Italia (ora legale)
  workflow_dispatch:

permissions:
  contents: write

jobs:
  controlla:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      # solo le dipendenze del server: niente frontend, niente OCR
      - run: npm install --omit=dev --workspaces=false --include-workspace-root
      - run: npm run controlla
      - name: Salva i prezzi nuovi
        run: |
          git config user.name  "soglia"
          git config user.email "soglia@local"
          git add dati/prodotti.json
          git diff --staged --quiet || git commit -m "prezzi aggiornati"
          git push
